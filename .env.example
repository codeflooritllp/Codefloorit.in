# ---- Contact form email (server only) ----
# Read by api/contact.js on Vercel. Set them in Vercel > Project > Settings > Environment
# Variables, never in front-end code. They have no VITE_ prefix, so Vite never bundles them.
# GoDaddy Professional Email. Check the setup with: node scripts/verify-smtp.mjs (see docs/contact-form-backend.md)
SMTP_HOST=smtpout.secureserver.net
# 465 = SSL/TLS from the start. 587 = STARTTLS. Plain unencrypted SMTP is refused.
SMTP_PORT=465
SMTP_USER=info@codefloorit.in
# The mailbox password. Only ever in Vercel (marked Sensitive) or your shell, never in a file in the repo.
SMTP_PASS=
CONTACT_TO_EMAIL=info@codefloorit.in
# Optional: the From address, if your provider's login is not itself an email address.
# SMTP_FROM=

# ---- Contact form destination (front end, public) ----
# Unset: the form posts to the site's own /api/contact (normal).
# Set to another URL that accepts a JSON POST to send enquiries there; add its origin to
# connect-src in the Content-Security-Policy in vercel.json, or the browser will block it.
# Set to an empty value to switch the form back to opening WhatsApp with the message filled in.
# VITE_CONTACT_ENDPOINT=
